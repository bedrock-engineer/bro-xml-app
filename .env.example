# Sentry DSN (public, safe to expose — it's shipped in the client bundle).
# Used by both the browser SDK (entry.client.tsx) and the worker (workers/app.ts).
# Inlined at build time, so it must be set when running `npm run build`.
VITE_SENTRY_DSN=

# PostHog project token and ingest host (public, shipped in the client bundle).
# Used by the browser SDK (entry.client.tsx) and the server middleware
# (app/middleware/posthog.ts). Inlined at build time, so both must be set
# when running `npm run build`; if either is missing, dev throws and prod
# silently skips analytics.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=
